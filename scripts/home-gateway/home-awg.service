[Unit]
Description=Private AWG 3.1 server alongside VLESS
Wants=network-online.target
After=network-online.target ufw.service

[Service]
Type=simple
Environment=LOG_LEVEL=error
ExecStart=/usr/local/bin/amneziawg-go -f awgsrv0
ExecStartPost=+/usr/bin/python3 /usr/local/lib/home-awg/awg_runtime.py server-up
ExecStopPost=+/usr/bin/python3 /usr/local/lib/home-awg/awg_runtime.py server-down
Restart=on-failure
RestartSec=3
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/amneziawg
RuntimeDirectory=amneziawg
RuntimeDirectoryPreserve=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
