[Unit]
Description=Standby direct DNS when the main home gateway is unavailable
After=network-online.target

[Service]
User=sing-box
Group=sing-box
ExecStart=/usr/bin/python3 /usr/local/lib/home-gateway/fallback_dns.py --config /etc/home-gateway-fallback.json
Restart=on-failure
RestartSec=3
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_UNIX
MemoryMax=64M
CPUQuota=10%
