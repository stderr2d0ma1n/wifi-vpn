[Unit]
Description=Isolated validation of standby DNS recovery

[Service]
User=sing-box
Group=sing-box
ExecStart=/usr/bin/python3 /usr/local/lib/home-gateway/fallback_dns.py --config /run/home-gateway-lab/fallback-dns.json
Restart=no
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_UNIX
