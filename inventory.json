{
  "schema_version": 1,
  "prepared_date": "2026-10-15",
  "target": "wifi-vpn private source repository; no deployed credentials or local state",
  "objects": [
    {
      "id": "home-gateway",
      "kind": "scripts",
      "purpose": "Prepare and manage a Linux home gateway with native AmneziaWG uplink, compact pinned domain/IP routing, kernel whole-device bypass, guarded activation and local automatic recovery to direct routing/DNS. Verify using a real isolated virtual client without activating household traffic. Includes VLESS comparison, private iPhone export and Orange Pi recovery tools.",
      "status": "active_awg_owner_confirmed_auto_rollback_enabled",
      "paths": [
        "scripts/home-gateway"
      ],
      "dependencies": [
        "Python >= 3.9",
        "Linux with systemd, TUN, nftables and nfqueue",
        "sing-box 1.14 from official repository",
        "iproute2, netplan, curl and dnsutils; root for initial installation and packet tests",
        "SSH access to the user-owned board",
        "Optional VPS: fresh Debian/Ubuntu server, official signed sing-box package, ufw, verified SSH key access and a suitable reachable TLS handshake host",
        "Optional macOS USB recovery: Xcode Command Line Tools and libusb",
        "Optional image personalization: e2fsprogs debugfs, official Armbian image, SSH public key",
        "Optional AWG userspace build: official pinned Go 1.27.2, AmneziaWG Go/tools sources, make/gcc/libc headers for ARM CLI; see README",
        "Optional iPhone profiles: AmneziaWG with AWG 3.1 support or Happ; private AirDrop/file import",
        "Optional Xray interoperability check: verified official Linux release binary for target architecture",
        "Optional private JSON QR: macOS system CoreImage/ImageIO/UniformTypeIdentifiers and Swift Command Line Tools; local decode verification",
        "Optional private subscription import: existing working AWG, Python 3.9+, systemd LoadCredential support, iptables, service user sing-box; manual 15-minute service only",
        "Home readiness: existing isolated AWG peer and vpn-monitor group; pinned binary SRS rule sets from MetaCubeX and runetfreedom; see HOME_READY.md"
      ],
      "restore": "Follow scripts/home-gateway/README.md and HOME_READY.md. Compare installed sources and preserve local settings before upgrades. Public per-device deployment metadata stays in .local-only; SSH/VPN secrets remain in existing private paths outside Git. Run isolated readiness verification after policy/source changes. Household activation requires separate explicit owner OK; never restore by blindly enabling rules."
    },
    {
      "id": "vpn-monitor",
      "kind": "scripts_and_module",
      "purpose": "Read-only AmneziaWG monitoring with isolated probes, debounced health, SQLite history/events, weekly official upstream checks, loopback API/Prometheus, gateway rollback status and deduplicated SSH notifications for a future unified personal admin.",
      "status": "deployed_gateway_rollback_aware_household_rules",
      "paths": [
        "scripts/vpn-monitor"
      ],
      "dependencies": [
        "Python >= 3.9 standard library",
        "Linux systemd with NetworkNamespacePath, curl, iproute2 and CA certificates",
        "Existing isolated home-gateway AmneziaWG probe units",
        "SSH client and POSIX file locking for optional notification consumer",
        "Optional Codex desktop heartbeat notifications require the host awake, app running and SSH connectivity"
      ],
      "restore": "Follow scripts/vpn-monitor/README.md; personalize public configuration outside Git. Preserve installed config and compare source hashes before upgrades. Private deployment inventory and automation IDs remain in local-only storage; VPN/SSH keys are never copied. Monitor does not activate household VPN or install protocol updates."
    }
  ],
